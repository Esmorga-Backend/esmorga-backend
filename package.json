{
  "name": "esmorga-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npm run test:cov:unit && npm run test:cov:component && npm run test:merge-coverage && npm run test:report",
    "test:create:cycle": "node test/scripts/features-tool --Create-Cycle-for-US",
    "test:unit": "jest --config ./test/jest-unit/jest-unit.config.json --detectOpenHandles",
    "test:cov:unit": "jest --config ./test/jest-unit/jest-unit.config.json --coverage --detectOpenHandles",
    "test:component": "node test/scripts/features-tool && jest --config ./test/jest-component/jest-component.config.json --detectOpenHandles --forceExit",
    "test:cov:component": "node test/scripts/features-tool && jest --config ./test/jest-component/jest-component.config.json --coverage --detectOpenHandles  --forceExit",
    "test:merge-coverage": "istanbul-merge --out coverage/merged-output/merged-coverage.json coverage/unit/coverage-final.json coverage/component/coverage-final.json",
    "test:report": "nyc report -t coverage/merged-output --report-dir coverage --reporter=html --reporter=cobertura --reporter=lcov",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e-run-cypress": "node test/scripts/features-tool && cypress run --config-file test/cypress-e2e/cypress.config.js --no-runner-ui --headless --browser chrome",
    "test:e2e-open-cypress": "node test/scripts/features-tool &&cypress open --config-file test/cypress-e2e/cypress.config.js",
    "migrate:local-up": "cp migrations_local.json migrations.json && npx mongo-migrate-ts up",
    "migrate:local-down-all": "cp migrations_local.json migrations.json && npx mongo-migrate-ts down -a",
    "migrate:qa-up": "cp migrations_qa.json migrations.json && npx mongo-migrate-ts up",
    "migrate:qa-down-all": "cp migrations_qa.json migrations.json && npx mongo-migrate-ts down -a",
    "migrate:prod-up": "cp migrations_prod.json migrations.json && npx mongo-migrate-ts up",
    "migrate:prod-down-all": "cp migrations_prod.json migrations.json && npx mongo-migrate-ts down -a",
    "playwright:testqa": "ENV_FILE=.env.qa npx playwright test",
    "playwright:happy-path": "npx playwright test --grep @happy-path",
    "playwright:testprod": "ENV_FILE=.env.prod npx playwright test"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "mongoose": "^9.0.0",
    "nestjs-pino": "^5.0.1",
    "nodemailer": "^9.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.4.0",
    "@nestjs/testing": "^11.1.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.12",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.20.0",
    "cypress": "^16.0.0",
    "directory-import": "^3.3.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "istanbul-merge": "^2.0.0",
    "jest": "^29.7.0",
    "jest-json-schema": "^6.1.0",
    "jest-junit": "^17.0.0",
    "mongo-migrate-ts": "^2.0.0",
    "nyc": "^18.0.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "swagger-parser": "^10.0.3",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0"
  },
  "nyc": {
    "report-dir": "./coverage/nyc",
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/config/*.ts",
      "src/infrastructure/db/repositories/mongo.repository.ts"
    ],
    "reporter": [
      "json"
    ]
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "step_definitions": "cypress/e2e/features/"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "cypress@16.0.0": true,
    "fsevents@2.3.3": true
  }
}
